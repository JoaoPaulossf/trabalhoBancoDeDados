<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: #ffffff;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.trabalho.controller.ConsultasController">
    <VBox spacing="14.0">
        <padding>
            <Insets bottom="20.0" left="22.0" right="22.0" top="18.0" />
        </padding>

        <!-- Header -->
        <VBox spacing="3.0">
            <Label style="-fx-text-fill: #0f172a;" text="Consultas e Relatórios do Sistema">
                <font>
                    <Font name="System Bold" size="18.0" />
                </font>
            </Label>
            <Label style="-fx-text-fill: #64748b; -fx-font-size: 12px;" text="Pesquise projetos por docente, lista de participantes por projeto, produções com autores e contratos de financiamento." />
        </VBox>

        <!-- TabPane com as 4 Consultas de Saida Especificadas no Documento -->
        <TabPane fx:id="tabPaneConsultas" minHeight="450.0" prefHeight="480.0" style="-fx-background-color: #ffffff; -fx-border-color: #e2e8f0; -fx-border-radius: 6px;" tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
            
            <!-- ABA 1: Projetos vinculados a um determinado docente -->
            <Tab text="  📁  Projetos por Docente  ">
                <VBox spacing="12.0">
                    <padding>
                        <Insets bottom="14.0" left="14.0" right="14.0" top="14.0" />
                    </padding>
                    <HBox alignment="CENTER_LEFT" spacing="10.0">
                        <Label style="-fx-font-weight: bold; -fx-text-fill: #334155;" text="Selecione o Docente Coordenador:" />
                        <ComboBox fx:id="cbFiltroDocente" prefWidth="280.0" promptText="Todos os Docentes" />
                        <Button mnemonicParsing="false" onAction="#filtrarProjetosPorDocente" style="-fx-background-color: #0284c7; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 4px; -fx-cursor: hand;" text="Buscar" />
                        <Button mnemonicParsing="false" onAction="#consultarTodosProjetos" style="-fx-background-color: #64748b; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 4px; -fx-cursor: hand;" text="Ver Todos" />
                    </HBox>
                    <Label fx:id="lblResultadoProjetos" style="-fx-font-size: 12px;" text="Resultado da busca" />
                    <TableView fx:id="tabelaProjetosDocente" minHeight="240.0" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colProjId" prefWidth="55.0" text="ID" />
                            <TableColumn fx:id="colProjTitulo" prefWidth="200.0" text="Título do Projeto" />
                            <TableColumn fx:id="colProjDescricao" prefWidth="180.0" text="Descrição" />
                            <TableColumn fx:id="colProjInicio" prefWidth="85.0" text="Início" />
                            <TableColumn fx:id="colProjTermino" prefWidth="85.0" text="Término" />
                            <TableColumn fx:id="colProjSituacao" prefWidth="95.0" text="Situação" />
                            <TableColumn fx:id="colProjCoordenador" prefWidth="150.0" text="Docente Responsável" />
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                        </columnResizePolicy>
                    </TableView>
                </VBox>
            </Tab>

            <!-- ABA 2: Lista de participantes de um projeto especifico -->
            <Tab text="  👥  Participantes por Projeto  ">
                <VBox spacing="12.0">
                    <padding>
                        <Insets bottom="14.0" left="14.0" right="14.0" top="14.0" />
                    </padding>
                    <HBox alignment="CENTER_LEFT" spacing="10.0">
                        <Label style="-fx-font-weight: bold; -fx-text-fill: #334155;" text="Selecione o Projeto de Pesquisa:" />
                        <ComboBox fx:id="cbFiltroProjetoParticipantes" prefWidth="300.0" promptText="Selecione um projeto" />
                        <Button mnemonicParsing="false" onAction="#filtrarParticipantesPorProjeto" style="-fx-background-color: #0284c7; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 4px; -fx-cursor: hand;" text="Buscar" />
                        <Button mnemonicParsing="false" onAction="#consultarTodosParticipantes" style="-fx-background-color: #64748b; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 4px; -fx-cursor: hand;" text="Ver Todos" />
                    </HBox>
                    <Label fx:id="lblResultadoParticipantes" style="-fx-font-size: 12px;" text="Resultado da busca" />
                    <TableView fx:id="tabelaParticipantesProjeto" minHeight="240.0" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colPartNome" prefWidth="160.0" text="Nome Participante" />
                            <TableColumn fx:id="colPartCpf" prefWidth="110.0" text="CPF" />
                            <TableColumn fx:id="colPartEmail" prefWidth="150.0" text="E-mail Institucional" />
                            <TableColumn fx:id="colPartTipo" prefWidth="100.0" text="Tipo de Vínculo" />
                            <TableColumn fx:id="colPartFuncao" prefWidth="130.0" text="Função no Projeto" />
                            <TableColumn fx:id="colPartInicio" prefWidth="85.0" text="Início" />
                            <TableColumn fx:id="colPartFim" prefWidth="85.0" text="Fim" />
                            <TableColumn fx:id="colPartStatus" prefWidth="85.0" text="Status" />
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                        </columnResizePolicy>
                    </TableView>
                </VBox>
            </Tab>

            <!-- ABA 3: Producoes cientificas vinculadas a um projeto -->
            <Tab text="  📄  Produções Científicas por Projeto  ">
                <VBox spacing="12.0">
                    <padding>
                        <Insets bottom="14.0" left="14.0" right="14.0" top="14.0" />
                    </padding>
                    <HBox alignment="CENTER_LEFT" spacing="10.0">
                        <Label style="-fx-font-weight: bold; -fx-text-fill: #334155;" text="Selecione o Projeto de Pesquisa:" />
                        <ComboBox fx:id="cbFiltroProjetoProducoes" prefWidth="300.0" promptText="Selecione um projeto" />
                        <Button mnemonicParsing="false" onAction="#filtrarProducoesPorProjeto" style="-fx-background-color: #0284c7; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 4px; -fx-cursor: hand;" text="Buscar" />
                        <Button mnemonicParsing="false" onAction="#consultarTodasProducoes" style="-fx-background-color: #64748b; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 4px; -fx-cursor: hand;" text="Ver Todas" />
                    </HBox>
                    <Label fx:id="lblResultadoProducoes" style="-fx-font-size: 12px;" text="Resultado da busca" />
                    <TableView fx:id="tabelaProducoesProjeto" minHeight="240.0" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colProdId" prefWidth="50.0" text="ID" />
                            <TableColumn fx:id="colProdTitulo" prefWidth="200.0" text="Título da Produção" />
                            <TableColumn fx:id="colProdTipo" prefWidth="120.0" text="Tipo" />
                            <TableColumn fx:id="colProdAno" prefWidth="65.0" text="Ano" />
                            <TableColumn fx:id="colProdMeio" prefWidth="150.0" text="Meio de Divulgação" />
                            <TableColumn fx:id="colProdAutores" prefWidth="190.0" text="Autores Vinculados" />
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                        </columnResizePolicy>
                    </TableView>
                </VBox>
            </Tab>

            <!-- ABA 4: Informacoes sobre os financiamentos cadastrados -->
            <Tab text="  💰  Financiamentos por Projeto  ">
                <VBox spacing="12.0">
                    <padding>
                        <Insets bottom="14.0" left="14.0" right="14.0" top="14.0" />
                    </padding>
                    <HBox alignment="CENTER_LEFT" spacing="10.0">
                        <Label style="-fx-font-weight: bold; -fx-text-fill: #334155;" text="Selecione o Projeto de Pesquisa:" />
                        <ComboBox fx:id="cbFiltroProjetoFinanciamento" prefWidth="300.0" promptText="Selecione um projeto" />
                        <Button mnemonicParsing="false" onAction="#filtrarFinanciamentoPorProjeto" style="-fx-background-color: #0284c7; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 4px; -fx-cursor: hand;" text="Buscar" />
                        <Button mnemonicParsing="false" onAction="#consultarTodosFinanciamentos" style="-fx-background-color: #64748b; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 4px; -fx-cursor: hand;" text="Ver Todos" />
                    </HBox>
                    <Label fx:id="lblResultadoFinanciamento" style="-fx-font-size: 12px;" text="Resultado da busca" />
                    <TableView fx:id="tabelaFinanciamentoProjeto" minHeight="240.0" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colFinProjeto" prefWidth="180.0" text="Projeto" />
                            <TableColumn fx:id="colFinAgencia" prefWidth="110.0" text="Agência" />
                            <TableColumn fx:id="colFinTipo" prefWidth="150.0" text="Tipo de Fomento" />
                            <TableColumn fx:id="colFinValor" prefWidth="110.0" text="Valor Total" />
                            <TableColumn fx:id="colFinSituacao" prefWidth="85.0" text="Situação" />
                            <TableColumn fx:id="colFinInicio" prefWidth="90.0" text="Início Vigência" />
                            <TableColumn fx:id="colFinFim" prefWidth="90.0" text="Fim Vigência" />
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                        </columnResizePolicy>
                    </TableView>
                </VBox>
            </Tab>

        </TabPane>
    </VBox>
</ScrollPane>
